# ~/.zshrc.local — rendered by 48-secrets.sh from configs/secrets/.zshrc.local.
#
# Write secret *references*, never values. At setup, `op read` fetches each
# op://<vault>/<item>/<field> from 1Password and writes it single-quoted to
# ~/.zshrc.local (mode 600), which ~/.zshrc sources last. Only comments and
# lines of exactly this shape are allowed, so no value can become shell code:
#   export NAME="op://<vault>/<item>/<field>"
# Copy a reference with 1Password → item → field → "Copy Secret Reference".
#
# Until a line below is uncommented, nothing is rendered.
#
# export GITHUB_TOKEN="op://Private/GitHub/token"
# export ANTHROPIC_API_KEY="op://Private/Anthropic/credential"
# export OPENAI_API_KEY="op://Private/OpenAI/credential"
