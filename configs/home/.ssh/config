# GitHub's host keys are pinned (github_known_hosts, linked beside this file),
# so a fresh Mac never has to trust whatever answers first as github.com.
Host github.com
	User git
	IdentityFile ~/.ssh/github-darkhawwk.pub
	IdentitiesOnly yes
	UserKnownHostsFile ~/.ssh/known_hosts ~/.ssh/github_known_hosts

Host *
	IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
