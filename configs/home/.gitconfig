[user]
	name = Ben Walther
	email = thebenwalther@gmail.com
	# Public half of the 1Password "SSH Key" (also your GitHub key). Public keys
	# are safe to publish; the private half never leaves 1Password.
	signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIJE/Ekd6tppJdSCLipOXnBedx9AAziBAsG0glrsfD2fY

# Sign every commit and tag with that key through 1Password (Touch ID).
[gpg]
	format = ssh
[gpg "ssh"]
	program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
	allowedSignersFile = ~/.config/git/allowed_signers
[commit]
	gpgsign = true
[tag]
	gpgsign = true
